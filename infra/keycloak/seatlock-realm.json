{
  "realm": "seatlock",
  "enabled": true,
  "displayName": "SeatLock local security lab",
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "SeatLock customer"
      },
      {
        "name": "inventory.reserve",
        "description": "Machine inventory reservation permission"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "booking-audience",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "booking-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "booking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "inventory-audience",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "seatlock-cli",
      "name": "SeatLock CLI dev-only public client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "booking-audience"
      ]
    },
    {
      "clientId": "seatlock-booking-service",
      "name": "Booking machine account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev_only_booking_machine_secret_2026",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "inventory-audience"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@seatlock.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Local",
      "realmRoles": [
        "customer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev_only_alice_password",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "email": "bob@seatlock.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Local",
      "realmRoles": [
        "customer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev_only_bob_password",
          "temporary": false
        }
      ]
    },
    {
      "username": "observer",
      "email": "observer@seatlock.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Observer",
      "lastName": "Local",
      "credentials": [
        {
          "type": "password",
          "value": "dev_only_observer_password",
          "temporary": false
        }
      ]
    }
  ]
}
