diff --git a/infra/nginx/seatlock-booking.conf b/infra/nginx/seatlock-booking.conf
new file mode 100644
index 0000000..2f63ff2
--- /dev/null
+++ b/infra/nginx/seatlock-booking.conf
@@ -0,0 +1,24 @@
+# LOCAL LINUX DEMO ONLY. Uses host networking; Booking JVMs must be on 8083 and 8084.
+upstream seatlock_booking_pool {
+    least_conn;
+    server 127.0.0.1:8083 max_fails=2 fail_timeout=10s;
+    server 127.0.0.1:8084 max_fails=2 fail_timeout=10s;
+    keepalive 16;
+}
+server {
+    listen 127.0.0.1:8085;
+    server_name _;
+    location / {
+        proxy_pass http://seatlock_booking_pool;
+        proxy_http_version 1.1;
+        proxy_set_header Connection "";
+        proxy_set_header Host $http_host;
+        proxy_set_header Authorization $http_authorization;
+        proxy_set_header Idempotency-Key $http_idempotency_key;
+        proxy_set_header X-Request-ID $http_x_request_id;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_connect_timeout 2s;
+        proxy_read_timeout 6s;
+        add_header X-Upstream-Addr $upstream_addr always;
+    }
+}
